# =============================================================================
# Affidavit Express - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Site URL (for email links - frontend URL)
SITE_URL=http://localhost:5173

# =============================================================================
# Database (SQLite by default, configure for PostgreSQL in production)
# =============================================================================
# DATABASE_URL=postgres://user:password@localhost:5432/affidavit_express

# =============================================================================
# Redis / Celery Configuration
# =============================================================================
# Run Redis in Docker Desktop:
# docker run -d --name redis -p 6379:6379 redis:alpine
CELERY_BROKER_URL=redis://localhost:6379/0

# =============================================================================
# Email Configuration
# =============================================================================
# For Gmail, use an App Password (not your regular password)
# Go to: Google Account > Security > 2-Step Verification > App Passwords

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Affidavit Express <your-email@gmail.com>

# For development, use console backend to print emails to terminal:
# EMAIL_BACKEND=console

# =============================================================================
# OpenAI API Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DRAFT_MODEL=gpt-4o-mini
OPENAI_QA_MODEL=gpt-4o

# =============================================================================
# CORS (Frontend URLs allowed to access the API)
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================================================
# Other Settings
# =============================================================================
REQUEST_LOCK_TIMEOUT_MINUTES=15
